<!--
  VCR OSD - EmulationStation theme for 640x480 handhelds (R36S / ArkOS / dArkOS)
  Shared layout. Every system folder sets its variables and includes this file.
  Positions are in screen fractions; the comments give the pixel value at 640x480.
  The top-right corner (x > 448px, y < 40px) stays empty for the battery/clock.
-->
<theme>
  <formatVersion>7</formatVersion>

  <!-- ====================================================== SYSTEM VIEW -->
  <view name="system">
    <image name="background" extra="true">
      <pos>0 0</pos><size>1 1</size>
      <path>./../_art/ui/bg_system_blue.png</path>
      <zIndex>0</zIndex>
    </image>
    <image name="console" extra="true">
      <!-- 360x240 hardware art at (140,46): drawn at its native size, no blur -->
      <pos>0.21875 0.095833</pos><size>0.5625 0.5</size>
      <path>./../_art/consoles/${sysArt}.png</path>
      <zIndex>10</zIndex>
    </image>
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.608333</pos>
      <size>1 0.133333</size>
      <logoSize>0.75 0.133333</logoSize>
      <logoScale>1.0</logoScale>
      <maxLogoCount>1</maxLogoCount>
      <logoAlignment>center</logoAlignment>
      <color>00000000</color>
      <zIndex>40</zIndex>
    </carousel>
    <image name="logo">
      <path>./../_art/logos/${sysArt}.png</path>
    </image>
    <text name="logoText">
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.06673</fontSize>
      <color>F0F0F8FF</color>
      <forceUppercase>true</forceUppercase>
    </text>
    <text name="sysInfo" extra="true">
      <!-- maker and release year, e.g. NINTENDO * 1990 * CONSOLE -->
      <text>${sysMaker} · ${sysYear} · ${sysKind}</text>
      <pos>0.025 0.75</pos><size>0.95 0.045833</size>
      <alignment>center</alignment>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <color>F0F0F8FF</color>
      <forceUppercase>true</forceUppercase>
      <zIndex>45</zIndex>
    </text>
    <text name="systemInfo">
      <pos>0.025 0.8</pos><size>0.95 0.045833</size>
      <alignment>center</alignment>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <color>8C9CFFFF</color>
      <backgroundColor>00000000</backgroundColor>
      <forceUppercase>true</forceUppercase>
      <zIndex>45</zIndex>
    </text>
    <image name="timeline" extra="true">
      <!-- BEGIN/END tape counter bar; the marker sits on the release year -->
      <pos>0.1875 0.845833</pos><size>0.625 0.083333</size>
      <path>./../_art/timeline/${sysArt}.png</path>
      <zIndex>45</zIndex>
    </image>
    <helpsystem name="help">
      <pos>0.025 0.964583</pos>
      <origin>0 0.5</origin>
      <textColor>000FC0FF</textColor>
      <iconColor>000FC0FF</iconColor>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
    </helpsystem>
  </view>

  <!-- ===================================================== GAMELIST VIEWS -->
  <view name="basic,detailed,video">
    <image name="background" extra="true">
      <pos>0 0</pos><size>1 1</size>
      <path>./../_art/ui/bg_gamelist_blue.png</path>
      <zIndex>0</zIndex>
    </image>
    <text name="sysTag" extra="true">
      <!-- inverse OSD tag with the system name, like the highlighted AUTO box -->
      <text>▶ ${sysName}</text>
      <pos>0.025 0.020833</pos><size>${tagW} 0.05</size>
      <alignment>center</alignment>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <color>000FC0FF</color>
      <backgroundColor>E4E4ECFF</backgroundColor>
      <forceUppercase>true</forceUppercase>
      <zIndex>50</zIndex>
    </text>
    <textlist name="gamelist">
      <!-- left column: x 16..330, y 56..438 -->
      <pos>0.025 0.116667</pos><size>0.490625 0.795833</size>
      <selectorColor>E4E4ECFF</selectorColor>
      <selectedColor>000FC0FF</selectedColor>
      <primaryColor>F0F0F8FF</primaryColor>
      <secondaryColor>8C9CFFFF</secondaryColor>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.05006</fontSize>
      <lineSpacing>1.5</lineSpacing>
      <alignment>left</alignment>
      <horizontalMargin>0.0125</horizontalMargin>
      <forceUppercase>true</forceUppercase>
      <zIndex>20</zIndex>
    </textlist>
    <image name="md_image">
      <!-- box art: top two thirds of the right panel (x 352..620, y 60..312) -->
      <pos>0.759375 0.3875</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.409375 0.508333</maxSize>
      <default>./../_art/ui/no_signal.png</default>
      <zIndex>30</zIndex>
    </image>
    <video name="md_video">
      <pos>0.759375 0.3875</pos>
      <origin>0.5 0.5</origin>
      <maxSize>0.409375 0.508333</maxSize>
      <delay>1.5</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <default>./../_art/ui/no_signal.png</default>
      <zIndex>31</zIndex>
    </video>
    <rating name="md_rating">
      <!-- bottom third: five 24px pixel stars next to the RATING label -->
      <pos>0.696875 0.675</pos><size>0.1875 0.05</size>
      <filledPath>./../_art/ui/star_filled.png</filledPath>
      <unfilledPath>./../_art/ui/star_unfilled.png</unfilledPath>
      <zIndex>40</zIndex>
    </rating>
    <text name="md_description">
      <!-- bottom third: small 16px text, scrolls automatically -->
      <pos>0.55625 0.7375</pos><size>0.409375 0.170833</size>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <lineSpacing>1.25</lineSpacing>
      <color>F0F0F8FF</color>
      <alignment>left</alignment>
      <zIndex>40</zIndex>
    </text>
    <text name="md_lbl_rating"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_releasedate"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_developer"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_publisher"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_genre"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_players"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_lastplayed"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_lbl_playcount"><pos>2 2</pos><size>0.01 0.01</size></text>
    <datetime name="md_releasedate"><pos>2 2</pos><size>0.01 0.01</size></datetime>
    <text name="md_developer"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_publisher"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_genre"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_players"><pos>2 2</pos><size>0.01 0.01</size></text>
    <datetime name="md_lastplayed"><pos>2 2</pos><size>0.01 0.01</size></datetime>
    <text name="md_playcount"><pos>2 2</pos><size>0.01 0.01</size></text>
    <text name="md_name"><pos>2 2</pos><size>0.01 0.01</size></text>
    <image name="md_marquee"><pos>2 2</pos><size>0.01 0.01</size></image>
    <helpsystem name="help">
      <pos>0.025 0.964583</pos>
      <origin>0 0.5</origin>
      <textColor>000FC0FF</textColor>
      <iconColor>000FC0FF</iconColor>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
    </helpsystem>
  </view>

  <view name="basic">
    <!-- the basic view has no box art, so the console fills the art window -->
    <image name="consoleSmall" extra="true">
      <pos>0.759375 0.3875</pos><origin>0.5 0.5</origin><size>0.375 0.333333</size>
      <path>./../_art/consoles/small/${sysArt}.png</path>
      <zIndex>30</zIndex>
    </image>
  </view>

  <view name="grid">
    <image name="background" extra="true">
      <pos>0 0</pos><size>1 1</size>
      <path>./../_art/ui/bg_plain_blue.png</path>
    </image>
    <imagegrid name="gamegrid">
      <pos>0.025 0.116667</pos><size>0.95 0.795833</size>
      <margin>0.01875 0.025</margin>
      <padding>0.01875 0.025</padding>
    </imagegrid>
    <gridtile name="default">
      <size>0.171875 0.25</size>
      <backgroundColor>00000000</backgroundColor>
    </gridtile>
    <gridtile name="selected">
      <backgroundColor>E4E4ECFF</backgroundColor>
    </gridtile>
    <helpsystem name="help">
      <pos>0.025 0.964583</pos><origin>0 0.5</origin>
      <textColor>000FC0FF</textColor><iconColor>000FC0FF</iconColor>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath><fontSize>0.03340</fontSize>
    </helpsystem>
  </view>

  <!-- ======================================== SETTINGS MENU = SAME OSD LOOK -->
  <view name="menu">
    <menuBackground name="menubg">
      <color>000FC0FF</color>
      <path>./../_art/ui/menu_frame_blue.png</path>
      <cornerSize>16 16</cornerSize>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.06673</fontSize>
      <color>F0F0F8FF</color>
    </menuText>
    <menuText name="menutext">
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.05006</fontSize>
      <color>F0F0F8FF</color>
      <separatorColor>8C9CFF80</separatorColor>
      <selectedColor>000FC0FF</selectedColor>
      <selectorColor>E4E4ECFF</selectorColor>
    </menuText>
    <menuText name="menutextsmall">
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <color>8C9CFFFF</color>
      <selectedColor>000FC0FF</selectedColor>
    </menuText>
    <menuText name="menufooter">
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <color>8C9CFFFF</color>
    </menuText>
    <menuSwitch name="menuswitch">
      <pathOn>./../_art/ui/switch_on_blue.png</pathOn>
      <pathOff>./../_art/ui/switch_off.png</pathOff>
    </menuSwitch>
    <menuSlider name="menuslider">
      <path>./../_art/ui/slider_knob.png</path>
    </menuSlider>
    <menuButton name="menubutton">
      <path>./../_art/ui/button_blue.png</path>
      <filledPath>./../_art/ui/button_filled.png</filledPath>
    </menuButton>
    <menuTextEdit name="menutextedit">
      <inactive>./../_art/ui/textinput_blue.png</inactive>
      <active>./../_art/ui/textinput_active_blue.png</active>
    </menuTextEdit>
    <menuIcons name="menuicons">
      <iconOptionListArrow>./../_art/ui/arrow_down.png</iconOptionListArrow>
      <iconArrow>./../_art/ui/arrow_right.png</iconArrow>
    </menuIcons>
  </view>

  <!-- ============================================ SPLASH / LOADING SCREEN -->
  <view name="splash">
    <image name="background">
      <pos>0 0</pos><size>1 1</size>
      <path>./../_art/loading/loading_blue.png</path>
    </image>
    <image name="logo">
      <pos>2 2</pos><size>0.01 0.01</size>
    </image>
    <text name="label">
      <pos>0.025 0.845833</pos><size>0.95 0.045833</size>
      <alignment>left</alignment>
      <fontPath>./../_art/fonts/OSDTape-Chunky.ttf</fontPath>
      <fontSize>0.03340</fontSize>
      <color>F0F0F8FF</color>
    </text>
  </view>
</theme>
