<!-- Font size: SMALL (16px list and menu text; descriptions stay small at 16px) -->
<theme>
  <formatVersion>7</formatVersion>
  <view name="basic,detailed,video">
    <textlist name="gamelist">
      <fontSize>0.03340</fontSize>
      <lineSpacing>1.6</lineSpacing>
    </textlist>
  </view>
  <view name="menu">
    <menuText name="menutitle"><fontSize>0.05006</fontSize></menuText>
    <menuText name="menutext"><fontSize>0.03340</fontSize></menuText>
  </view>
</theme>
