<!-- Colour scheme dark-amber (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<color>FFB02040</color>
		</image>
		<image name="kickerBar">
			<color>FFB020</color>
		</image>
		<image name="selMarker">
			<color>FFB020</color>
		</image>
		<image name="tileGlow">
			<color>FFB020</color>
		</image>
		<text name="systemInfo">
			<color>FFB020</color>
		</text>
		<image name="helpBarAccent">
			<color>FFB020</color>
		</image>
		<helpsystem name="help">
			<iconColor>FFB020</iconColor>
		</helpsystem>
	</view>
	<view name="basic, detailed, video, grid">
		<image name="bgGlow">
			<color>FFB02040</color>
		</image>
		<image name="headerBar">
			<color>FFB020</color>
		</image>
		<textlist name="gamelist">
			<selectorColor>FFB020</selectorColor>
			<selectorColorEnd>FFB02090</selectorColorEnd>
			<secondaryColor>FFB020</secondaryColor>
		</textlist>
		<image name="md_image">
			<default>./../art/noart/dark-amber.png</default>
		</image>
		<rating name="md_rating">
			<color>FFB020</color>
		</rating>
		<image name="helpBarAccent">
			<color>FFB020</color>
		</image>
		<helpsystem name="help">
			<iconColor>FFB020</iconColor>
		</helpsystem>
	</view>
	<view name="basic">
		<image name="tileGlow">
			<color>FFB020</color>
		</image>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../art/noart/dark-amber.png</gameImage>
			<folderImage>./../art/noart/dark-amber.png</folderImage>
		</imagegrid>
		<gridtile name="selected">
			<backgroundColor>FFB020</backgroundColor>
		</gridtile>
	</view>
	<view name="menu">
		<menuText name="menutitle">
			<color>FFB020</color>
		</menuText>
		<menuText name="menutext">
			<selectorColor>FFB020</selectorColor>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../art/switch/on_amber.png</pathOn>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../art/switch/knob_amber.png</path>
		</menuSlider>
	</view>
</theme>
