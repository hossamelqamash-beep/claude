<!-- Colour scheme dark-multi (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<color>${sysColor}40</color>
		</image>
		<image name="kickerBar">
			<color>${sysColor}</color>
		</image>
		<image name="selMarker">
			<color>${sysColor}</color>
		</image>
		<image name="tileGlow">
			<color>${sysColor}</color>
		</image>
		<text name="systemInfo">
			<color>${sysColor}</color>
		</text>
		<image name="helpBarAccent">
			<color>${sysColor}</color>
		</image>
		<helpsystem name="help">
			<iconColor>${sysColor}</iconColor>
		</helpsystem>
	</view>
	<view name="basic, detailed, video, grid">
		<image name="bgGlow">
			<color>${sysColor}40</color>
		</image>
		<image name="headerBar">
			<color>${sysColor}</color>
		</image>
		<textlist name="gamelist">
			<selectorColor>${sysColor}</selectorColor>
			<selectorColorEnd>${sysColor}90</selectorColorEnd>
			<secondaryColor>${sysColor}</secondaryColor>
		</textlist>
		<image name="md_image">
			<default>./../art/noart/dark-multi.png</default>
		</image>
		<rating name="md_rating">
			<color>${sysColor}</color>
		</rating>
		<image name="helpBarAccent">
			<color>${sysColor}</color>
		</image>
		<helpsystem name="help">
			<iconColor>${sysColor}</iconColor>
		</helpsystem>
	</view>
	<view name="basic">
		<image name="tileGlow">
			<color>${sysColor}</color>
		</image>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../art/noart/dark-multi.png</gameImage>
			<folderImage>./../art/noart/dark-multi.png</folderImage>
		</imagegrid>
		<gridtile name="selected">
			<backgroundColor>${sysColor}</backgroundColor>
		</gridtile>
	</view>
	<view name="menu">
		<menuText name="menutitle">
			<color>${sysColor}</color>
		</menuText>
		<menuText name="menutext">
			<selectorColor>${sysColor}</selectorColor>
		</menuText>
	</view>
</theme>
