<!-- System list layout vertical (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<pos>0.2 0.5</pos>
			<size>0.9 1.25</size>
		</image>
		<carousel name="systemcarousel">
			<logoAlignment>center</logoAlignment>
			<pos>0.02 0.09</pos>
			<size>0.36 0.835</size>
			<logoSize>0.19 0.2533</logoSize>
			<logoScale>1.38</logoScale>
			<maxLogoCount>3</maxLogoCount>
		</carousel>
		<image name="logo">
			<path>./../art/icons/${system.theme}.png</path>
		</image>
		<text name="kicker">
			<pos>0.42 0.3</pos>
		</text>
		<image name="kickerBar">
			<pos>0.42 0.352</pos>
		</image>
		<text name="sysName" extra="true">
			<text>${system.fullName}</text>
			<pos>0.42 0.37</pos>
			<size>0.56 0.37</size>
			<alignment>left</alignment>
			<verticalAlignment>top</verticalAlignment>
			<fontPath>./../art/fonts/BarlowCondensed-Bold.ttf</fontPath>
			<fontSize>0.09</fontSize>
			<color>F3F3F7</color>
			<forceUppercase>true</forceUppercase>
			<lineSpacing>1.0</lineSpacing>
			<zIndex>45</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.42 0.745</pos>
			<size>0.56 0.06</size>
			<alignment>left</alignment>
		</text>
		<image name="selMarker">
			<pos>2 2</pos>
		</image>
		<image name="tileBody">
			<pos>2 2</pos>
		</image>
		<image name="tileGlow">
			<pos>2 2</pos>
		</image>
		<image name="tileLogo">
			<pos>2 2</pos>
		</image>
	</view>
</theme>
