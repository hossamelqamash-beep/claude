<!-- System list layout horizontal (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<pos>0.5 0.42</pos>
			<size>1.1 1.3</size>
		</image>
		<carousel name="systemcarousel">
			<logoAlignment>center</logoAlignment>
			<type>horizontal</type>
			<pos>0 0.13</pos>
			<size>1 0.54</size>
			<logoSize>0.30 0.40</logoSize>
			<maxLogoCount>3</maxLogoCount>
		</carousel>
		<image name="logo">
			<path>./../art/icons/${system.theme}.png</path>
		</image>
		<text name="sysName" extra="true">
			<text>${system.fullName}</text>
			<pos>0.05 0.675</pos>
			<size>0.9 0.10</size>
			<alignment>center</alignment>
			<fontPath>./../art/fonts/BarlowCondensed-Bold.ttf</fontPath>
			<fontSize>0.09</fontSize>
			<color>F3F3F7</color>
			<forceUppercase>true</forceUppercase>
			<zIndex>45</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.05 0.775</pos>
			<size>0.9 0.06</size>
		</text>
		<image name="selMarker">
			<pos>2 2</pos>
		</image>
		<image name="tileBody">
			<pos>2 2</pos>
		</image>
		<image name="tileGlow">
			<pos>2 2</pos>
		</image>
		<image name="tileLogo">
			<pos>2 2</pos>
		</image>
	</view>
</theme>
