<!-- System list layout wheel (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<pos>0.78 0.5</pos>
			<size>1.0 1.333</size>
		</image>
		<carousel name="systemcarousel">
			<logoAlignment>right</logoAlignment>
			<logoRotation>24</logoRotation>
			<logoRotationOrigin>-1.25 0.5</logoRotationOrigin>
			<type>vertical_wheel</type>
			<pos>0.50 0.085</pos>
			<size>0.50 0.84</size>
			<logoSize>0.26 0.3467</logoSize>
			<logoScale>1.25</logoScale>
		</carousel>
		<image name="logo">
			<path>./../art/icons/${system.theme}.png</path>
		</image>
		<text name="kicker">
			<pos>0.05 0.3</pos>
		</text>
		<image name="kickerBar">
			<pos>0.05 0.352</pos>
		</image>
		<text name="sysName" extra="true">
			<text>${system.fullName}</text>
			<pos>0.05 0.37</pos>
			<size>0.50 0.37</size>
			<alignment>left</alignment>
			<verticalAlignment>top</verticalAlignment>
			<fontPath>./../art/fonts/BarlowCondensed-Bold.ttf</fontPath>
			<fontSize>0.09</fontSize>
			<color>F3F3F7</color>
			<forceUppercase>true</forceUppercase>
			<lineSpacing>1.0</lineSpacing>
			<zIndex>45</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.05 0.745</pos>
			<size>0.48 0.06</size>
			<alignment>left</alignment>
		</text>
		<image name="selMarker">
			<pos>2 2</pos>
		</image>
		<image name="tileBody">
			<pos>2 2</pos>
		</image>
		<image name="tileGlow">
			<pos>2 2</pos>
		</image>
		<image name="tileLogo">
			<pos>2 2</pos>
		</image>
	</view>
</theme>
