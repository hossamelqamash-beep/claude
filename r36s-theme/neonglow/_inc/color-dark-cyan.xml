<!-- Colour scheme dark-cyan (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<color>1FCFEA40</color>
		</image>
		<image name="kickerBar">
			<color>1FCFEA</color>
		</image>
		<image name="selMarker">
			<color>1FCFEA</color>
		</image>
		<image name="tileGlow">
			<color>1FCFEA</color>
		</image>
		<text name="systemInfo">
			<color>1FCFEA</color>
		</text>
		<image name="helpBarAccent">
			<color>1FCFEA</color>
		</image>
		<helpsystem name="help">
			<iconColor>1FCFEA</iconColor>
		</helpsystem>
	</view>
	<view name="basic, detailed, video, grid">
		<image name="bgGlow">
			<color>1FCFEA40</color>
		</image>
		<image name="headerBar">
			<color>1FCFEA</color>
		</image>
		<textlist name="gamelist">
			<selectorColor>1FCFEA</selectorColor>
			<selectorColorEnd>1FCFEA90</selectorColorEnd>
			<secondaryColor>1FCFEA</secondaryColor>
		</textlist>
		<image name="md_image">
			<default>./../art/noart/dark-cyan.png</default>
		</image>
		<rating name="md_rating">
			<color>1FCFEA</color>
		</rating>
		<image name="helpBarAccent">
			<color>1FCFEA</color>
		</image>
		<helpsystem name="help">
			<iconColor>1FCFEA</iconColor>
		</helpsystem>
	</view>
	<view name="basic">
		<image name="tileGlow">
			<color>1FCFEA</color>
		</image>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../art/noart/dark-cyan.png</gameImage>
			<folderImage>./../art/noart/dark-cyan.png</folderImage>
		</imagegrid>
		<gridtile name="selected">
			<backgroundColor>1FCFEA</backgroundColor>
		</gridtile>
	</view>
	<view name="menu">
		<menuText name="menutitle">
			<color>1FCFEA</color>
		</menuText>
		<menuText name="menutext">
			<selectorColor>1FCFEA</selectorColor>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../art/switch/on_cyan.png</pathOn>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../art/switch/knob_cyan.png</path>
		</menuSlider>
	</view>
</theme>
