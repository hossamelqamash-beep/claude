<!-- Colour scheme dark-violet (generated by tools/build_xml.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgGlow">
			<color>9B5CFF40</color>
		</image>
		<image name="kickerBar">
			<color>9B5CFF</color>
		</image>
		<image name="selMarker">
			<color>9B5CFF</color>
		</image>
		<image name="tileGlow">
			<color>9B5CFF</color>
		</image>
		<text name="systemInfo">
			<color>9B5CFF</color>
		</text>
		<image name="helpBarAccent">
			<color>9B5CFF</color>
		</image>
		<helpsystem name="help">
			<iconColor>9B5CFF</iconColor>
		</helpsystem>
	</view>
	<view name="basic, detailed, video, grid">
		<image name="bgGlow">
			<color>9B5CFF40</color>
		</image>
		<image name="headerBar">
			<color>9B5CFF</color>
		</image>
		<textlist name="gamelist">
			<selectorColor>9B5CFF</selectorColor>
			<selectorColorEnd>9B5CFF90</selectorColorEnd>
			<secondaryColor>9B5CFF</secondaryColor>
		</textlist>
		<image name="md_image">
			<default>./../art/noart/dark-violet.png</default>
		</image>
		<rating name="md_rating">
			<color>9B5CFF</color>
		</rating>
		<image name="helpBarAccent">
			<color>9B5CFF</color>
		</image>
		<helpsystem name="help">
			<iconColor>9B5CFF</iconColor>
		</helpsystem>
	</view>
	<view name="basic">
		<image name="tileGlow">
			<color>9B5CFF</color>
		</image>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../art/noart/dark-violet.png</gameImage>
			<folderImage>./../art/noart/dark-violet.png</folderImage>
		</imagegrid>
		<gridtile name="selected">
			<backgroundColor>9B5CFF</backgroundColor>
		</gridtile>
	</view>
	<view name="menu">
		<menuText name="menutitle">
			<color>9B5CFF</color>
		</menuText>
		<menuText name="menutext">
			<selectorColor>9B5CFF</selectorColor>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../art/switch/on_violet.png</pathOn>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../art/switch/knob_violet.png</path>
		</menuSlider>
	</view>
</theme>
