<?xml version="1.0" encoding="UTF-8"?>
<!-- DeskOS for EmulationStation (fcamod / ArkOS / AmberELEC / batocera-style) - generated by tools/build.py -->
<theme>
  <formatVersion>7</formatVersion>

  <!-- ======================= THEME OPTIONS (Main menu > UI settings > Theme configuration) -->
  <!-- the first entry of every subset is the default -->
  <include subset="colorset" name="classic" displayName="Classic Cream">./colors/classic.xml</include>
  <include subset="colorset" name="amber" displayName="Amber CRT">./colors/amber.xml</include>
  <include subset="colorset" name="phosphor" displayName="Green Phosphor">./colors/phosphor.xml</include>
  <include subset="colorset" name="pocket" displayName="Pocket Pea">./colors/pocket.xml</include>
  <include subset="colorset" name="ice" displayName="Ice Blue">./colors/ice.xml</include>
  <include subset="colorset" name="bubblegum" displayName="Bubblegum">./colors/bubblegum.xml</include>
  <include subset="colorset" name="paperwhite" displayName="Paper White">./colors/paperwhite.xml</include>
  <include subset="fontsize" subSetDisplayName="Font size" name="medium" displayName="Medium">./fontsize/medium.xml</include>
  <include subset="fontsize" subSetDisplayName="Font size" name="small" displayName="Small">./fontsize/small.xml</include>
  <include subset="fontsize" subSetDisplayName="Font size" name="big" displayName="Big">./fontsize/big.xml</include>
  <include subset="wallpaper" subSetDisplayName="Wallpaper" name="bevel" displayName="Dither Bevel">./wallpaper/bevel.xml</include>
  <include subset="wallpaper" subSetDisplayName="Wallpaper" name="dots" displayName="Dot Grid">./wallpaper/dots.xml</include>
  <include subset="wallpaper" subSetDisplayName="Wallpaper" name="weave" displayName="Weave">./wallpaper/weave.xml</include>
  <include subset="wallpaper" subSetDisplayName="Wallpaper" name="scanlines" displayName="Scanlines">./wallpaper/scanlines.xml</include>
  <include subset="wallpaper" subSetDisplayName="Wallpaper" name="plain" displayName="Plain">./wallpaper/plain.xml</include>
  <include subset="gamelistview" name="boxart" displayName="Box art (image tag)">./artsource/image.xml</include>
  <include subset="gamelistview" name="thumbnail" displayName="Box art (thumbnail tag)">./artsource/thumbnail.xml</include>
  <include subset="gamelistview" name="marquee" displayName="Logo / marquee tag">./artsource/marquee.xml</include>

  <!-- ======================= SYSTEM VIEW -->
  <view name="system">
    <image name="staticBackground">
      <pos>0.000000 0.000000</pos>
      <size>1.000000 1.000000</size>
      <path>../_art/wallpaper/${palette}_${wallpaper}.png</path>
      <zIndex>0</zIndex>
    </image>
    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0.093750 0.700000</pos>
      <size>0.812500 0.116667</size>
      <logoSize>0.625000 0.116667</logoSize>
      <logoScale>1</logoScale>
      <maxLogoCount>1</maxLogoCount>
      <color>00000000</color>
      <defaultTransition>slide</defaultTransition>
      <systemInfoDelay>0</systemInfoDelay>
      <zIndex>40</zIndex>
    </carousel>
    <text name="systemInfo">
      <pos>0.059375 0.933333</pos>
      <size>0.415625 0.045833</size>
      <alignment>left</alignment>
      <verticalAlignment>center</verticalAlignment>
      <backgroundColor>00000000</backgroundColor>
      <forceUppercase>true</forceUppercase>
      <zIndex>50</zIndex>
    </text>
    <helpsystem name="help">
      <pos>0.509375 0.939583</pos>
      <iconUpDown>../_art/help/updown.png</iconUpDown>
      <iconLeftRight>../_art/help/leftright.png</iconLeftRight>
      <iconUpDownLeftRight>../_art/help/dpad.png</iconUpDownLeftRight>
      <iconA>../_art/help/a.png</iconA>
      <iconB>../_art/help/b.png</iconB>
      <iconX>../_art/help/x.png</iconX>
      <iconY>../_art/help/y.png</iconY>
      <iconL>../_art/help/l.png</iconL>
      <iconR>../_art/help/r.png</iconR>
      <iconStart>../_art/help/start.png</iconStart>
      <iconSelect>../_art/help/select.png</iconSelect>
    </helpsystem>
  </view>

  <!-- ======================= GAME LIST: list left, box art top-right (2/3), info bottom-right (1/3) -->
  <view name="basic,detailed,video,grid">
    <image name="background">
      <pos>0.000000 0.000000</pos>
      <size>1.000000 1.000000</size>
      <path>../_art/wallpaper/${palette}_${wallpaper}.png</path>
      <zIndex>0</zIndex>
    </image>
    <image name="chromePaper" extra="true">
      <pos>0.000000 0.000000</pos>
      <size>1.000000 1.000000</size>
      <path>../_art/ui/gamelist_paper.png</path>
      <color>${paperColor}</color>
      <zIndex>2</zIndex>
    </image>
    <image name="chromeInk" extra="true">
      <pos>0.000000 0.000000</pos>
      <size>1.000000 1.000000</size>
      <path>../_art/ui/gamelist_ink.png</path>
      <color>${inkColor}</color>
      <zIndex>3</zIndex>
    </image>
    <image name="logo">
      <pos>0.087500 0.047917</pos>
      <origin>0 0</origin>
      <size>0.406250 0.041667</size>
      <zIndex>10</zIndex>
    </image>
    <text name="logoText">
      <pos>0.087500 0.045833</pos>
      <size>0.406250 0.045833</size>
      <alignment>left</alignment>
      <forceUppercase>true</forceUppercase>
      <zIndex>10</zIndex>
    </text>
    <textlist name="gamelist">
      <pos>0.028125 0.183333</pos>
      <size>0.443750 0.716667</size>
      <alignment>left</alignment>
      <horizontalMargin>0.008</horizontalMargin>
      <forceUppercase>false</forceUppercase>
      <zIndex>20</zIndex>
    </textlist>
    <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.746875 0.404167</pos>
      <maxSize>0.456250 0.441667</maxSize>
      <zIndex>20</zIndex>
    </image>
    <image name="md_thumbnail">
      <origin>0.5 0.5</origin>
      <pos>0.746875 0.404167</pos>
      <maxSize>0.456250 0.441667</maxSize>
      <visible>false</visible>
      <zIndex>21</zIndex>
    </image>
    <image name="md_marquee">
      <origin>0.5 0.5</origin>
      <pos>0.746875 0.404167</pos>
      <maxSize>0.456250 0.441667</maxSize>
      <visible>false</visible>
      <zIndex>21</zIndex>
    </image>
    <video name="md_video">
      <origin>0.5 0.5</origin>
      <pos>0.746875 0.404167</pos>
      <maxSize>0.456250 0.441667</maxSize>
      <delay>1.5</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <zIndex>22</zIndex>
    </video>
    <rating name="md_rating">
      <pos>0.518750 0.733333</pos>
      <size>0.125000 0.033333</size>
      <filledPath>../_art/ui/star_filled.png</filledPath>
      <unfilledPath>../_art/ui/star_empty.png</unfilledPath>
      <zIndex>25</zIndex>
    </rating>
    <text name="md_genre">
      <pos>0.656250 0.729167</pos>
      <size>0.318750 0.041667</size>
      <alignment>right</alignment>
      <verticalAlignment>center</verticalAlignment>
      <zIndex>25</zIndex>
    </text>
    <text name="md_description">
      <pos>0.518750 0.787500</pos>
      <size>0.456250 0.120833</size>
      <alignment>left</alignment>
      <lineSpacing>1.1</lineSpacing>
      <zIndex>25</zIndex>
    </text>
    <text name="md_name"><visible>false</visible></text>
    <text name="md_lbl_rating"><visible>false</visible></text>
    <text name="md_lbl_releasedate"><visible>false</visible></text>
    <text name="md_lbl_developer"><visible>false</visible></text>
    <text name="md_lbl_publisher"><visible>false</visible></text>
    <text name="md_lbl_genre"><visible>false</visible></text>
    <text name="md_lbl_players"><visible>false</visible></text>
    <text name="md_lbl_lastplayed"><visible>false</visible></text>
    <text name="md_lbl_playcount"><visible>false</visible></text>
    <text name="md_developer"><visible>false</visible></text>
    <text name="md_publisher"><visible>false</visible></text>
    <text name="md_players"><visible>false</visible></text>
    <text name="md_playcount"><visible>false</visible></text>
    <datetime name="md_releasedate"><visible>false</visible></datetime>
    <datetime name="md_lastplayed"><visible>false</visible></datetime>
    <helpsystem name="help">
      <pos>0.031250 0.939583</pos>
      <iconUpDown>../_art/help/updown.png</iconUpDown>
      <iconLeftRight>../_art/help/leftright.png</iconLeftRight>
      <iconUpDownLeftRight>../_art/help/dpad.png</iconUpDownLeftRight>
      <iconA>../_art/help/a.png</iconA>
      <iconB>../_art/help/b.png</iconB>
      <iconX>../_art/help/x.png</iconX>
      <iconY>../_art/help/y.png</iconY>
      <iconL>../_art/help/l.png</iconL>
      <iconR>../_art/help/r.png</iconR>
      <iconStart>../_art/help/start.png</iconStart>
      <iconSelect>../_art/help/select.png</iconSelect>
    </helpsystem>
  </view>
  <view name="basic">
    <image name="chromeInk" extra="true">
      <pos>0.000000 0.000000</pos>
      <size>1.000000 1.000000</size>
      <path>../_art/ui/gamelist_basic_ink.png</path>
      <color>${inkColor}</color>
      <zIndex>3</zIndex>
    </image>
    <image name="chromePaper" extra="true">
      <pos>0.000000 0.000000</pos>
      <size>1.000000 1.000000</size>
      <path>../_art/ui/gamelist_basic_paper.png</path>
      <color>${paperColor}</color>
      <zIndex>2</zIndex>
    </image>
  </view>

  <!-- ======================= SCREEN: clock sits in the taskbar well (enable 'Show clock' in UI settings) -->
  <view name="screen">
    <text name="clock">
      <pos>0.837500 0.933333</pos>
      <size>0.143750 0.045833</size>
      <alignment>center</alignment>
    </text>
  </view>

  <!-- ======================= MENUS (same window style as the desktop) -->
  <view name="menu">
    <menuBackground name="menubg">
      <path>../_art/palette/${palette}/menu_frame.png</path>
      <fadePath>../_art/palette/${palette}/menu_fade.png</fadePath>
      <color>FFFFFFFF</color>
      <cornerSize>16 16</cornerSize>
    </menuBackground>
    <menuSwitch name="menuswitch">
      <pathOn>../_art/palette/${palette}/switch_on.png</pathOn>
      <pathOff>../_art/palette/${palette}/switch_off.png</pathOff>
    </menuSwitch>
    <menuSlider name="menuslider">
      <path>../_art/palette/${palette}/slider_knob.png</path>
    </menuSlider>
    <menuButton name="menubutton">
      <path>../_art/palette/${palette}/button.png</path>
      <filledPath>../_art/palette/${palette}/button_filled.png</filledPath>
    </menuButton>
    <menuTextEdit name="menutextedit">
      <inactive>../_art/palette/${palette}/textedit.png</inactive>
      <active>../_art/palette/${palette}/textedit_active.png</active>
    </menuTextEdit>
  </view>
</theme>
