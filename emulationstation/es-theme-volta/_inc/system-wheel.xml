<!-- System view: wheel carousel (generated by build/build.py) -->
<theme>
	<formatVersion>6</formatVersion>
	<view name="system">
		<image name="background" extra="true">
			<path>./../_art/${cs}/system-wheel.jpg</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<carousel name="systemcarousel">
			<type>vertical_wheel</type>
			<pos>0.625 0.1</pos>
			<size>0.35625 0.82917</size>
			<color>00000000</color>
			<logoSize>0.26562 0.08333</logoSize>
			<logoScale>1.15</logoScale>
			<logoRotation>9</logoRotation>
			<logoRotationOrigin>3.2 0.5</logoRotationOrigin>
			<maxLogoCount>7</maxLogoCount>
			<logoAlignment>center</logoAlignment>
			<systemInfoDelay>0</systemInfoDelay>
			<zIndex>40</zIndex>
		</carousel>
		<image name="logo">
			<path>./../_art/logos/${system.theme}.png</path>
			<pos>0 0</pos>
			<color>${logo}</color>
			<zIndex>41</zIndex>
		</image>
		<text name="logoText">
			<pos>0 0</pos>
			<size>0 0</size>
			<fontPath>${fontSemi}</fontPath>
			<fontSize>0.03229</fontSize>
			<color>${logo}</color>
			<alignment>left</alignment>
		</text>
		<text name="sysName" extra="true">
			<text>${system.fullName}</text>
			<pos>0.05625 0.14167</pos>
			<size>0.51875 0.06667</size>
			<fontPath>${fontSemi}</fontPath>
			<fontSize>${sysFont}</fontSize>
			<color>${cardText}</color>
			<alignment>left</alignment>
			<zIndex>12</zIndex>
		</text>
		<text name="sysMaker" extra="true">
			<text>${sysMaker}</text>
			<pos>0.05625 0.2125</pos>
			<size>0.51875 0.04167</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02396</fontSize>
			<color>${cardDim}</color>
			<alignment>left</alignment>
			<zIndex>12</zIndex>
		</text>
		<image name="sysLogoBig" extra="true">
			<path>./../_art/logos/${system.theme}.png</path>
			<pos>0.31562 0.45833</pos>
			<maxSize>0.39062 0.2</maxSize>
			<origin>0.5 0.5</origin>
			<color>${logoCard}</color>
			<zIndex>12</zIndex>
		</image>
		<text name="sysYearLabel" extra="true">
			<text>${sysYearLabel}</text>
			<pos>0.05625 0.7375</pos>
			<size>0.23438 0.0375</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
			<color>${cardDim}</color>
			<alignment>left</alignment>
			<forceUppercase>true</forceUppercase>
			<zIndex>12</zIndex>
		</text>
		<text name="sysYear" extra="true">
			<text>${sysYear}</text>
			<pos>0.05312 0.77917</pos>
			<size>0.26562 0.10417</size>
			<fontPath>${fontDot}</fontPath>
			<fontSize>0.07187</fontSize>
			<color>${cardText}</color>
			<alignment>left</alignment>
			<zIndex>12</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.3125 0.81667</pos>
			<size>0.2625 0.0625</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
			<color>${cardText}</color>
			<alignment>center</alignment>
			<backgroundColor>00000000</backgroundColor>
		</text>
		<helpsystem name="help">
			<pos>0.02187 0.95</pos>
			<textColor>${bgDim}</textColor>
			<iconColor>${bgText}</iconColor>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
		</helpsystem>
	</view>
</theme>
