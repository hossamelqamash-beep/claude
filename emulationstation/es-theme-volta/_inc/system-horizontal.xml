<!-- System view: horizontal carousel (generated by build/build.py) -->
<theme>
	<formatVersion>6</formatVersion>
	<view name="system">
		<image name="background" extra="true">
			<path>./../_art/${cs}/system-horizontal.jpg</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<carousel name="systemcarousel">
			<type>horizontal</type>
			<pos>0 0.2125</pos>
			<size>1 0.40833</size>
			<color>00000000</color>
			<logoSize>0.2625 0.15417</logoSize>
			<logoScale>1.32</logoScale>
			<maxLogoCount>3</maxLogoCount>
			<logoAlignment>center</logoAlignment>
			<systemInfoDelay>0</systemInfoDelay>
			<zIndex>40</zIndex>
		</carousel>
		<image name="logo">
			<path>./../_art/logos/${system.theme}.png</path>
			<pos>0 0</pos>
			<color>${logoCard}</color>
			<zIndex>41</zIndex>
		</image>
		<text name="logoText">
			<pos>0 0</pos>
			<size>0 0</size>
			<fontPath>${fontSemi}</fontPath>
			<fontSize>0.04896</fontSize>
			<color>${logoCard}</color>
			<alignment>left</alignment>
		</text>
		<text name="sysName" extra="true">
			<text>${system.fullName}</text>
			<pos>0.0625 0.65</pos>
			<size>0.875 0.07083</size>
			<fontPath>${fontSemi}</fontPath>
			<fontSize>${sysFont}</fontSize>
			<color>${bgText}</color>
			<alignment>center</alignment>
			<zIndex>12</zIndex>
		</text>
		<text name="sysMaker" extra="true">
			<text>${sysMakerYear}</text>
			<pos>0.0625 0.72083</pos>
			<size>0.875 0.04583</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02396</fontSize>
			<color>${bgDim}</color>
			<alignment>center</alignment>
			<zIndex>12</zIndex>
		</text>
		<text name="systemInfo">
			<pos>0.34063 0.79167</pos>
			<size>0.33437 0.05833</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
			<color>${statusText}</color>
			<alignment>center</alignment>
			<backgroundColor>00000000</backgroundColor>
		</text>
		<helpsystem name="help">
			<pos>0.02187 0.95</pos>
			<textColor>${bgDim}</textColor>
			<iconColor>${bgText}</iconColor>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
		</helpsystem>
	</view>
</theme>
