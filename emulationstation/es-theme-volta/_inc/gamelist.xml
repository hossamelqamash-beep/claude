<!-- Game list views (generated by build/build.py) -->
<theme>
	<formatVersion>6</formatVersion>
	<view name="basic, detailed, video, grid">
		<image name="background">
			<path>./../_art/${cs}/gamelist.jpg</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="logo">
			<path>./../_art/logos/${system.theme}.png</path>
			<pos>0.08438 0.05</pos>
			<maxSize>0.3125 0.05417</maxSize>
			<origin>0 0.5</origin>
			<color>${logo}</color>
			<zIndex>50</zIndex>
		</image>
		<textlist name="gamelist">
			<pos>0.02813 0.12083</pos>
			<size>0.45937 0.7875</size>
			<selectorImagePath>./../_art/${cs}/selector-${fs}.png</selectorImagePath>
			<selectorImageTile>false</selectorImageTile>
			<selectorColor>FFFFFFFF</selectorColor>
			<selectorColorEnd>FFFFFFFF</selectorColorEnd>
			<selectorHeight>${selHeight}</selectorHeight>
			<selectorOffsetY>${selOffset}</selectorOffsetY>
			<selectedColor>${selText}</selectedColor>
			<primaryColor>${text}</primaryColor>
			<secondaryColor>${accent}</secondaryColor>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${listFont}</fontSize>
			<lineSpacing>${listSpacing}</lineSpacing>
			<alignment>left</alignment>
			<horizontalMargin>0.0219</horizontalMargin>
			<zIndex>20</zIndex>
		</textlist>
		<helpsystem name="help">
			<pos>0.02187 0.95</pos>
			<textColor>${bgDim}</textColor>
			<iconColor>${bgText}</iconColor>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
		</helpsystem>
	</view>
	<view name="detailed, video, grid">
		<image name="md_image">
			<pos>0.74531 0.37292</pos>
			<maxSize>0.44062 0.50417</maxSize>
			<origin>0.5 0.5</origin>
			<zIndex>30</zIndex>
			<default>./../_art/${cs}/noart.png</default>
			<roundCorners>0.025</roundCorners>
		</image>
		<rating name="md_rating">
			<pos>0.5375 0.68542</pos>
			<size>0 0.03125</size>
			<filledPath>./../_art/ui/star-filled.png</filledPath>
			<unfilledPath>./../_art/ui/star-empty.png</unfilledPath>
			<color>${star}</color>
			<unfilledColor>${starOff}</unfilledColor>
			<zIndex>40</zIndex>
		</rating>
		<datetime name="md_releasedate">
			<pos>0.76562 0.675</pos>
			<size>0.1875 0.05</size>
			<fontPath>${fontDot}</fontPath>
			<fontSize>0.03229</fontSize>
			<color>${cardText}</color>
			<alignment>right</alignment>
			<format>%Y</format>
			<zIndex>40</zIndex>
		</datetime>
		<text name="md_genre">
			<pos>0.67188 0.68125</pos>
			<size>0.18125 0.0375</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>0.02187</fontSize>
			<color>${cardDim}</color>
			<alignment>left</alignment>
			<singleLineScroll>false</singleLineScroll>
			<zIndex>40</zIndex>
		</text>
		<text name="md_description">
			<pos>0.5375 0.75</pos>
			<size>0.41563 ${descHeight}</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${descFont}</fontSize>
			<color>${cardText}</color>
			<alignment>left</alignment>
			<lineSpacing>1.25</lineSpacing>
			<zIndex>40</zIndex>
		</text>
		<text name="md_lbl_rating">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_releasedate">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_developer">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_publisher">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_genre">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_players">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_lastplayed">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_lbl_playcount">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_developer">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_publisher">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_players">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<datetime name="md_lastplayed">
			<visible>false</visible>
			<pos>2 2</pos>
		</datetime>
		<text name="md_playcount">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
		<text name="md_name">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
	</view>
	<view name="video">
		<video name="md_video">
			<pos>0.74531 0.37292</pos>
			<maxSize>0.44062 0.50417</maxSize>
			<origin>0.5 0.5</origin>
			<default>./../_art/${cs}/noart.png</default>
			<delay>1.2</delay>
			<showSnapshotNoVideo>true</showSnapshotNoVideo>
			<showSnapshotDelay>true</showSnapshotDelay>
			<roundCorners>0.025</roundCorners>
			<zIndex>31</zIndex>
		</video>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<pos>0.03125 0.11667</pos>
			<size>0.45312 0.79583</size>
			<margin>0.00937 0.0125</margin>
			<autoLayout>3 3</autoLayout>
			<autoLayoutSelectedZoom>1</autoLayoutSelectedZoom>
			<imageSource>image</imageSource>
			<gameImage>./../_art/${cs}/noart.png</gameImage>
			<folderImage>./../_art/${cs}/noart.png</folderImage>
			<scrollDirection>vertical</scrollDirection>
			<centerSelection>false</centerSelection>
			<zIndex>20</zIndex>
		</imagegrid>
		<gridtile name="default">
			<padding>4 4</padding>
			<imageColor>FFFFFFFF</imageColor>
			<backgroundColor>${text}10</backgroundColor>
			<backgroundCenterColor>${text}10</backgroundCenterColor>
			<backgroundEdgeColor>${text}10</backgroundEdgeColor>
			<backgroundImage>./../_art/ui/tile.png</backgroundImage>
			<backgroundCornerSize>0.07 0.07</backgroundCornerSize>
		</gridtile>
		<gridtile name="selected">
			<backgroundColor>${accent}FF</backgroundColor>
			<backgroundCenterColor>${accent}FF</backgroundCenterColor>
			<backgroundEdgeColor>${accent}FF</backgroundEdgeColor>
		</gridtile>
		<text name="md_name">
			<visible>false</visible>
			<pos>2 2</pos>
		</text>
	</view>
	<view name="basic">
		<image name="background">
			<path>./../_art/${cs}/gamelist-basic.jpg</path>
			<pos>0 0</pos>
			<size>1 1</size>
			<zIndex>0</zIndex>
		</image>
		<image name="basicLogo" extra="true">
			<path>./../_art/logos/${system.theme}.png</path>
			<pos>0.74531 0.34375</pos>
			<maxSize>0.34375 0.175</maxSize>
			<origin>0.5 0.5</origin>
			<color>${dim}</color>
			<zIndex>30</zIndex>
		</image>
		<text name="basicName" extra="true">
			<text>${system.fullName}</text>
			<pos>0.53438 0.46875</pos>
			<size>0.42188 0.05</size>
			<fontPath>${fontSemi}</fontPath>
			<fontSize>0.02813</fontSize>
			<color>${text}</color>
			<alignment>center</alignment>
			<zIndex>30</zIndex>
		</text>
		<text name="basicHint" extra="true">
			<text>No game info yet. Open the menu with START and run the scraper to add box art, descriptions and ratings.</text>
			<pos>0.5375 0.69583</pos>
			<size>0.41563 0.2</size>
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${descFont}</fontSize>
			<color>${cardText}</color>
			<alignment>left</alignment>
			<zIndex>30</zIndex>
			<lineSpacing>1.25</lineSpacing>
		</text>
	</view>
</theme>
