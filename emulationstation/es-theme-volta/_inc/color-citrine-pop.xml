<!-- Colour scheme Citrine Pop (generated by build/xmlgen.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgHorizontal">
			<path>./../_art/citrine-pop/system-horizontal.png</path>
		</image>
		<image name="bgVertical">
			<path>./../_art/citrine-pop/system-vertical.png</path>
		</image>
		<image name="bgWheel">
			<path>./../_art/citrine-pop/system-wheel.png</path>
		</image>
		<image name="logo">
			<color>111111FF</color>
		</image>
		<text name="logoText">
			<color>111111FF</color>
		</text>
		<text name="hName">
			<color>111111FF</color>
		</text>
		<text name="hMaker">
			<color>11111199</color>
		</text>
		<text name="cName">
			<color>111111FF</color>
		</text>
		<text name="cMaker">
			<color>111111A8</color>
		</text>
		<image name="cLogo">
			<color>111111FF</color>
		</image>
		<text name="cYearLabel">
			<color>111111A8</color>
		</text>
		<text name="cYear">
			<color>111111FF</color>
		</text>
		<text name="systemInfo">
			<color>111111FF</color>
		</text>
		<helpsystem name="help">
			<textColor>11111199</textColor>
			<iconColor>111111FF</iconColor>
		</helpsystem>
	</view>
	<view name="basic,detailed,video,grid">
		<image name="background">
			<path>./../_art/citrine-pop/gamelist.png</path>
		</image>
		<image name="logo">
			<color>111111FF</color>
		</image>
		<textlist name="gamelist">
			<selectorImagePath>./../_art/citrine-pop/selector.png</selectorImagePath>
		</textlist>
		<helpsystem name="help">
			<textColor>11111199</textColor>
			<iconColor>111111FF</iconColor>
		</helpsystem>
	</view>
	<view name="detailed,video,grid">
		<image name="md_image">
			<default>./../_art/citrine-pop/noart.png</default>
		</image>
		<datetime name="md_releasedate">
			<color>F4F4F6FF</color>
		</datetime>
		<text name="md_genre">
			<color>F4F4F6A8</color>
		</text>
		<text name="md_description">
			<color>F4F4F6FF</color>
		</text>
	</view>
	<view name="video">
		<video name="md_video">
			<default>./../_art/citrine-pop/noart.png</default>
		</video>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../_art/citrine-pop/noart.png</gameImage>
			<folderImage>./../_art/citrine-pop/noart.png</folderImage>
		</imagegrid>
	</view>
	<view name="basic">
		<image name="background">
			<path>./../_art/citrine-pop/gamelist-basic.png</path>
		</image>
		<text name="basicHint">
			<color>F4F4F6FF</color>
		</text>
	</view>
	<view name="menu">
		<menuBackground name="menubg">
			<path>./../_art/citrine-pop/menu.png</path>
		</menuBackground>
		<menuSwitch name="menuswitch">
			<pathOn>./../_art/citrine-pop/switch-on.png</pathOn>
			<pathOff>./../_art/citrine-pop/switch-off.png</pathOff>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../_art/citrine-pop/knob.png</path>
		</menuSlider>
		<menuButton name="menubutton">
			<path>./../_art/citrine-pop/button.png</path>
			<filledPath>./../_art/citrine-pop/button-filled.png</filledPath>
		</menuButton>
		<menuTextEdit name="menutextedit">
			<inactive>./../_art/citrine-pop/textedit.png</inactive>
			<active>./../_art/citrine-pop/textedit-active.png</active>
		</menuTextEdit>
	</view>
</theme>
