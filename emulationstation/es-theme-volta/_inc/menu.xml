<!-- Settings menu (generated by build/build.py) -->
<theme>
	<formatVersion>6</formatVersion>
	<view name="menu">
		<menuBackground name="menubg">
			<path>./../_art/${cs}/menu.png</path>
			<fadePath>./../_art/ui/fade.png</fadePath>
			<color>FFFFFFFF</color>
			<centerColor>FFFFFFFF</centerColor>
			<cornerSize>32 32</cornerSize>
		</menuBackground>
		<menuText name="menutitle">
			<fontPath>${fontSemi}</fontPath>
			<fontSize>${menuTitleFont}</fontSize>
			<color>${menuText}</color>
		</menuText>
		<menuText name="menutext">
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${menuFont}</fontSize>
			<color>${menuText}</color>
			<separatorColor>${menuLine}</separatorColor>
			<selectorColor>${menuSel}</selectorColor>
			<selectedColor>${menuSelText}</selectedColor>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${menuSmallFont}</fontSize>
			<color>${menuDim}</color>
		</menuTextSmall>
		<menuText name="menufooter">
			<fontPath>${fontMedium}</fontPath>
			<fontSize>${menuSmallFont}</fontSize>
			<color>${menuDim}</color>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../_art/${cs}/switch-on.png</pathOn>
			<pathOff>./../_art/${cs}/switch-off.png</pathOff>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../_art/${cs}/knob.png</path>
		</menuSlider>
		<menuButton name="menubutton">
			<path>./../_art/${cs}/button.png</path>
			<filledPath>./../_art/${cs}/button-filled.png</filledPath>
		</menuButton>
		<menuTextEdit name="menutextedit">
			<inactive>./../_art/${cs}/textedit.png</inactive>
			<active>./../_art/${cs}/textedit-active.png</active>
		</menuTextEdit>
	</view>
</theme>
