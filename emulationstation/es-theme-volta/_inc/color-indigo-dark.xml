<!-- Colour scheme Indigo Dark (generated by build/xmlgen.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgHorizontal">
			<path>./../_art/indigo-dark/system-horizontal.png</path>
		</image>
		<image name="bgVertical">
			<path>./../_art/indigo-dark/system-vertical.png</path>
		</image>
		<image name="bgWheel">
			<path>./../_art/indigo-dark/system-wheel.png</path>
		</image>
		<text name="hMaker">
			<color>8C8AB6FF</color>
		</text>
		<helpsystem name="help">
			<textColor>8C8AB6FF</textColor>
		</helpsystem>
	</view>
	<view name="basic,detailed,video,grid">
		<image name="background">
			<path>./../_art/indigo-dark/gamelist.png</path>
		</image>
		<textlist name="gamelist">
			<selectorImagePath>./../_art/indigo-dark/selector.png</selectorImagePath>
			<selectedColor>FFFFFFFF</selectedColor>
			<secondaryColor>A99BFFFF</secondaryColor>
		</textlist>
		<helpsystem name="help">
			<textColor>8C8AB6FF</textColor>
		</helpsystem>
	</view>
	<view name="detailed,video,grid">
		<image name="md_image">
			<default>./../_art/indigo-dark/noart.png</default>
		</image>
	</view>
	<view name="video">
		<video name="md_video">
			<default>./../_art/indigo-dark/noart.png</default>
		</video>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../_art/indigo-dark/noart.png</gameImage>
			<folderImage>./../_art/indigo-dark/noart.png</folderImage>
		</imagegrid>
		<gridtile name="selected">
			<backgroundColor>A99BFFFF</backgroundColor>
		</gridtile>
	</view>
	<view name="basic">
		<image name="background">
			<path>./../_art/indigo-dark/gamelist-basic.png</path>
		</image>
		<image name="basicLogo">
			<color>8C8AB6FF</color>
		</image>
	</view>
	<view name="menu">
		<menuBackground name="menubg">
			<path>./../_art/indigo-dark/menu.png</path>
		</menuBackground>
		<menuText name="menutext">
			<selectorColor>5146C4FF</selectorColor>
			<selectedColor>FFFFFFFF</selectedColor>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<color>8C8AB6FF</color>
		</menuTextSmall>
		<menuText name="menufooter">
			<color>8C8AB6FF</color>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../_art/indigo-dark/switch-on.png</pathOn>
			<pathOff>./../_art/indigo-dark/switch-off.png</pathOff>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../_art/indigo-dark/knob.png</path>
		</menuSlider>
		<menuButton name="menubutton">
			<path>./../_art/indigo-dark/button.png</path>
			<filledPath>./../_art/indigo-dark/button-filled.png</filledPath>
		</menuButton>
		<menuTextEdit name="menutextedit">
			<inactive>./../_art/indigo-dark/textedit.png</inactive>
			<active>./../_art/indigo-dark/textedit-active.png</active>
		</menuTextEdit>
	</view>
</theme>
