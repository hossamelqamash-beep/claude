<!-- Colour scheme Mint Dark (generated by build/xmlgen.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgHorizontal">
			<path>./../_art/mint-dark/system-horizontal.png</path>
		</image>
		<image name="bgVertical">
			<path>./../_art/mint-dark/system-vertical.png</path>
		</image>
		<image name="bgWheel">
			<path>./../_art/mint-dark/system-wheel.png</path>
		</image>
		<text name="hMaker">
			<color>80A190FF</color>
		</text>
		<helpsystem name="help">
			<textColor>80A190FF</textColor>
		</helpsystem>
	</view>
	<view name="basic,detailed,video,grid">
		<image name="background">
			<path>./../_art/mint-dark/gamelist.png</path>
		</image>
		<textlist name="gamelist">
			<selectorImagePath>./../_art/mint-dark/selector.png</selectorImagePath>
			<selectedColor>03140BFF</selectedColor>
			<secondaryColor>5BE38FFF</secondaryColor>
		</textlist>
		<helpsystem name="help">
			<textColor>80A190FF</textColor>
		</helpsystem>
	</view>
	<view name="detailed,video,grid">
		<image name="md_image">
			<default>./../_art/mint-dark/noart.png</default>
		</image>
		<rating name="md_rating">
			<color>5BE38FFF</color>
		</rating>
	</view>
	<view name="video">
		<video name="md_video">
			<default>./../_art/mint-dark/noart.png</default>
		</video>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../_art/mint-dark/noart.png</gameImage>
			<folderImage>./../_art/mint-dark/noart.png</folderImage>
		</imagegrid>
		<gridtile name="selected">
			<backgroundColor>5BE38FFF</backgroundColor>
		</gridtile>
	</view>
	<view name="basic">
		<image name="background">
			<path>./../_art/mint-dark/gamelist-basic.png</path>
		</image>
		<image name="basicLogo">
			<color>80A190FF</color>
		</image>
	</view>
	<view name="menu">
		<menuBackground name="menubg">
			<path>./../_art/mint-dark/menu.png</path>
		</menuBackground>
		<menuText name="menutext">
			<selectorColor>2FC270FF</selectorColor>
			<selectedColor>03140BFF</selectedColor>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<color>80A190FF</color>
		</menuTextSmall>
		<menuText name="menufooter">
			<color>80A190FF</color>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../_art/mint-dark/switch-on.png</pathOn>
			<pathOff>./../_art/mint-dark/switch-off.png</pathOff>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../_art/mint-dark/knob.png</path>
		</menuSlider>
		<menuButton name="menubutton">
			<path>./../_art/mint-dark/button.png</path>
			<filledPath>./../_art/mint-dark/button-filled.png</filledPath>
		</menuButton>
		<menuTextEdit name="menutextedit">
			<inactive>./../_art/mint-dark/textedit.png</inactive>
			<active>./../_art/mint-dark/textedit-active.png</active>
		</menuTextEdit>
	</view>
</theme>
