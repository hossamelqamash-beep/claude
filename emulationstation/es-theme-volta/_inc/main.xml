<!--
	Volta - EmulationStation theme for the R36S (ArkOS, 640x480)
	Generated by build/build.py - edit the generator, not this file.
-->
<theme>
	<formatVersion>6</formatVersion>
	<variables>
		<fontMedium>./../_fonts/Urbanist-Medium.ttf</fontMedium>
		<fontSemi>./../_fonts/Urbanist-SemiBold.ttf</fontSemi>
		<fontDot>./../_fonts/Doto-Black.ttf</fontDot>
	</variables>

	<!--
		Defaults first, so the theme still works if a subset setting holds a value
		this theme does not know. The subsets below override these variables.
	-->
	<include>./color-volta-dark.xml</include>
	<include>./font-medium.xml</include>

	<!--
		Options use Volta-specific setting keys (subset.voltacolor, ...). The shared
		keys (ThemeColorSet, ThemeSystemView) often hold names saved by the previous
		theme; no entry would match and ES would load no colours or carousel at all.
		First entry of each subset is the default.
	-->
	<subset name="voltacolor" displayName="Color scheme">
		<include name="volta-dark" displayName="Volta Dark">./color-volta-dark.xml</include>
		<include name="volta-light" displayName="Volta Light">./color-volta-light.xml</include>
		<include name="violet-dark" displayName="Violet Dark">./color-violet-dark.xml</include>
		<include name="violet-light" displayName="Violet Light">./color-violet-light.xml</include>
		<include name="indigo-dark" displayName="Indigo Dark">./color-indigo-dark.xml</include>
		<include name="indigo-light" displayName="Indigo Light">./color-indigo-light.xml</include>
		<include name="aqua-dark" displayName="Aqua Dark">./color-aqua-dark.xml</include>
		<include name="aqua-light" displayName="Aqua Light">./color-aqua-light.xml</include>
		<include name="ember-dark" displayName="Ember Dark">./color-ember-dark.xml</include>
		<include name="ember-light" displayName="Ember Light">./color-ember-light.xml</include>
		<include name="mint-dark" displayName="Mint Dark">./color-mint-dark.xml</include>
		<include name="mint-light" displayName="Mint Light">./color-mint-light.xml</include>
		<include name="citrine-pop" displayName="Citrine Pop">./color-citrine-pop.xml</include>
	</subset>
	<subset name="voltafont" displayName="Font size">
		<include name="medium" displayName="Medium">./font-medium.xml</include>
		<include name="small" displayName="Small">./font-small.xml</include>
		<include name="large" displayName="Large">./font-large.xml</include>
	</subset>
	<subset name="voltacarousel" displayName="System carousel">
		<include name="horizontal" displayName="Horizontal">./system-horizontal.xml</include>
		<include name="vertical" displayName="Vertical list">./system-vertical.xml</include>
		<include name="wheel" displayName="Wheel">./system-wheel.xml</include>
	</subset>

	<include>./gamelist.xml</include>
	<include>./menu.xml</include>
	<include>./screen.xml</include>
</theme>
