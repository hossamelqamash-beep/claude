<!-- Colour scheme Violet Light (generated by build/xmlgen.py) -->
<theme>
	<formatVersion>7</formatVersion>
	<view name="system">
		<image name="bgHorizontal">
			<path>./../_art/violet-light/system-horizontal.png</path>
		</image>
		<image name="bgVertical">
			<path>./../_art/violet-light/system-vertical.png</path>
		</image>
		<image name="bgWheel">
			<path>./../_art/violet-light/system-wheel.png</path>
		</image>
		<image name="logo">
			<color>25122FFF</color>
		</image>
		<text name="logoText">
			<color>25122FFF</color>
		</text>
		<text name="hName">
			<color>25122FFF</color>
		</text>
		<text name="hMaker">
			<color>76637FFF</color>
		</text>
		<text name="cName">
			<color>25122FFF</color>
		</text>
		<text name="cMaker">
			<color>25122FA8</color>
		</text>
		<image name="cLogo">
			<color>25122FFF</color>
		</image>
		<text name="cYearLabel">
			<color>25122FA8</color>
		</text>
		<text name="cYear">
			<color>25122FFF</color>
		</text>
		<text name="systemInfo">
			<color>25122FFF</color>
		</text>
		<helpsystem name="help">
			<textColor>76637FFF</textColor>
			<iconColor>25122FFF</iconColor>
		</helpsystem>
	</view>
	<view name="basic,detailed,video,grid">
		<image name="background">
			<path>./../_art/violet-light/gamelist.png</path>
		</image>
		<image name="logo">
			<color>25122FFF</color>
		</image>
		<textlist name="gamelist">
			<selectorImagePath>./../_art/violet-light/selector.png</selectorImagePath>
			<selectedColor>FFFFFFFF</selectedColor>
			<primaryColor>25122FFF</primaryColor>
			<secondaryColor>8E3FB8FF</secondaryColor>
		</textlist>
		<helpsystem name="help">
			<textColor>76637FFF</textColor>
			<iconColor>25122FFF</iconColor>
		</helpsystem>
	</view>
	<view name="detailed,video,grid">
		<image name="md_image">
			<default>./../_art/violet-light/noart.png</default>
		</image>
		<rating name="md_rating">
			<color>8E3FB8FF</color>
			<unfilledColor>25122F30</unfilledColor>
		</rating>
		<datetime name="md_releasedate">
			<color>25122FFF</color>
		</datetime>
		<text name="md_genre">
			<color>25122FA8</color>
		</text>
		<text name="md_description">
			<color>25122FFF</color>
		</text>
	</view>
	<view name="video">
		<video name="md_video">
			<default>./../_art/violet-light/noart.png</default>
		</video>
	</view>
	<view name="grid">
		<imagegrid name="gamegrid">
			<gameImage>./../_art/violet-light/noart.png</gameImage>
			<folderImage>./../_art/violet-light/noart.png</folderImage>
		</imagegrid>
		<gridtile name="default">
			<backgroundColor>25122F10</backgroundColor>
		</gridtile>
		<gridtile name="selected">
			<backgroundColor>8E3FB8FF</backgroundColor>
		</gridtile>
	</view>
	<view name="basic">
		<image name="background">
			<path>./../_art/violet-light/gamelist-basic.png</path>
		</image>
		<image name="basicLogo">
			<color>76637FFF</color>
		</image>
		<text name="basicName">
			<color>25122FFF</color>
		</text>
		<text name="basicHint">
			<color>25122FFF</color>
		</text>
	</view>
	<view name="menu">
		<menuBackground name="menubg">
			<path>./../_art/violet-light/menu.png</path>
		</menuBackground>
		<menuText name="menutitle">
			<color>25122FFF</color>
		</menuText>
		<menuText name="menutext">
			<color>25122FFF</color>
			<separatorColor>0000001A</separatorColor>
			<selectorColor>8A3CB2FF</selectorColor>
			<selectedColor>FFFFFFFF</selectedColor>
		</menuText>
		<menuTextSmall name="menutextsmall">
			<color>76637FFF</color>
		</menuTextSmall>
		<menuText name="menufooter">
			<color>76637FFF</color>
		</menuText>
		<menuSwitch name="menuswitch">
			<pathOn>./../_art/violet-light/switch-on.png</pathOn>
			<pathOff>./../_art/violet-light/switch-off.png</pathOff>
		</menuSwitch>
		<menuSlider name="menuslider">
			<path>./../_art/violet-light/knob.png</path>
		</menuSlider>
		<menuButton name="menubutton">
			<path>./../_art/violet-light/button.png</path>
			<filledPath>./../_art/violet-light/button-filled.png</filledPath>
		</menuButton>
		<menuTextEdit name="menutextedit">
			<inactive>./../_art/violet-light/textedit.png</inactive>
			<active>./../_art/violet-light/textedit-active.png</active>
		</menuTextEdit>
	</view>
</theme>
